{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AgentSecret": "",

  "Security": {
    "AllowUnauthenticatedAgents": false,
    "AllowLegacySharedAgentToken": false,
    "RequireHttps": false
  },

  "//": "Optional hardening / integrations — all disabled by default.",

  "Cors": {
    "AllowedOrigins": []
  },

  "Http": {
    "Enabled": true,
    "BindAddress": "0.0.0.0",
    "Port": 5050
  },

  "Https": {
    "Enabled": false,
    "Port": 5443
  },

  "Cef": {
    "Enabled": false,
    "Path": "C:\\ProgramData\\USBGuardian\\usbguardian_cef.log"
  },

  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": "usbguardian@yourcompany.com",
    "To": "secops@yourcompany.com"
  }
}
