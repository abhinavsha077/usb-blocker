{
  "Http": { "Enabled": false },
  "Https": { "Enabled": true, "Port": 5443 },
  "Security": {
    "RequireHttps": true,
    "AllowUnauthenticatedAgents": false,
    "AllowLegacySharedAgentToken": false
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Subject": "REPLACE_WITH_SERVER_CERTIFICATE_SUBJECT",
        "Store": "My",
        "Location": "LocalMachine",
        "AllowInvalid": false
      }
    }
  }
}
