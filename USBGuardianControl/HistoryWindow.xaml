<Window x:Class="USBGuardianControl.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Guardian | Event history" Height="620" Width="1000" MinHeight="460" MinWidth="760"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="lblTitle" Text="Event history" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Device activity and policy events for the selected endpoint. Times are shown in your local time zone." Style="{StaticResource HelpText}" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListView x:Name="lvHistory" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="Endpoint event history">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#EDF1F7"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="10,12"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                        <Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                    </ListView.Resources>
                    <ListView.View><GridView>
                        <GridViewColumn Header="Time" Width="155" DisplayMemberBinding="{Binding TimeText}"/>
                        <GridViewColumn Header="Event" Width="175"><GridViewColumn.CellTemplate><DataTemplate>
                            <Border Background="{Binding Color}" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left"><TextBlock Text="{Binding EventType}" Foreground="White" FontWeight="SemiBold" FontSize="11"/></Border>
                        </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="Device" Width="250"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DeviceText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="Detail" Width="310"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" ToolTip="{Binding Detail}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    </GridView></ListView.View>
                </ListView>
                <StackPanel x:Name="pnlEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed" MaxWidth="450">
                    <TextBlock x:Name="lblEmptyTitle" Text="No events recorded" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
                    <TextBlock x:Name="lblEmptyDescription" Text="Device activity will appear here after the endpoint reports it." Style="{StaticResource HelpText}" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="lblCount" Text="Loading events…" Style="{StaticResource HelpText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnRefreshHistory" Content="Refresh" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Click="BtnRefresh_Click"/>
                <Button Content="Close" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
