<Window x:Class="USBGuardianControl.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Guardian | Change admin password" Width="480" SizeToContent="Height"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Margin="24" Style="{StaticResource Card}" Padding="24">
        <StackPanel>
            <TextBlock Text="Change admin password" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Choose a password with 8–128 characters. Use the new password the next time you connect." Style="{StaticResource HelpText}" Margin="0,0,0,22"/>
            <TextBlock Text="New password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="txtNewPwd" AutomationProperties.Name="New admin password" Margin="0,0,0,14"/>
            <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="txtConfirmPwd" AutomationProperties.Name="Confirm admin password"/>
            <TextBlock x:Name="lblError" Foreground="#B42336" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource SecondaryBtn}" IsCancel="True" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="btnConfirm" Content="Change password" IsDefault="True" Click="BtnConfirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
