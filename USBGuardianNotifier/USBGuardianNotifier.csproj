<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>USBGuardianNotifier</AssemblyName>
    <!-- Runs in the interactive user session (via a run-at-logon entry), NOT as a service. -->
  </PropertyGroup>
</Project>
