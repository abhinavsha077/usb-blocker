<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.1.0</ProductVersion>
    <PayloadRoot Condition="'$(PayloadRoot)' == ''">$(MSBuildThisFileDirectory)..\artifacts</PayloadRoot>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadRoot=$(PayloadRoot)</DefineConstants>
    <InstallerPlatform>x64</InstallerPlatform>
    <Platform>x64</Platform>
    <OutputName>USBGuardian-Endpoint-$(ProductVersion)-x64</OutputName>
    <OutputPath>..\output\</OutputPath>
    <IntermediateOutputPath>..\obj\Endpoint\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>
</Project>
